if ( ! function_exists( 'wp_cache_supports' ) ) {
    function wp_cache_supports( $feature ) {
        return in_array(
            (string) $feature,
            array(
                'add_multiple',
                'delete_multiple',
                'flush_group',
                'flush_runtime',
                'get_multiple',
                'set_multiple',
            ),
            true
        );
    }
}

if ( ! isset( $GLOBALS['wp_object_cache'] ) || ! is_object( $GLOBALS['wp_object_cache'] ) ) {
    $GLOBALS['wp_object_cache'] = new WP_Object_Cache();
}
